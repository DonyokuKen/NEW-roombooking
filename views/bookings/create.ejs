<div class="container" style="max-width: 760px; padding: 2.5rem 1.5rem;">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Buat Booking Baru</h2>
    </div>
    <div class="card-body">
      <div id="conflict-warning" class="alert alert-warning" style="display: none;"></div>
      <form method="POST" action="/bookings" id="booking-form">
        <div class="form-group">
          <label class="form-label" for="room_id">Ruangan</label>
          <select name="room_id" id="room_id" class="form-control" required>
            <option value="">-- Pilih Ruangan --</option>
            <% rooms.forEach(room => { %>
              <option value="<%= room.id %>" <%= String(selectedRoomId) === String(room.id) ? 'selected' : '' %>><%= room.namaruangan %></option>
            <% }) %>
          </select>
        </div>
        <div class="grid grid-3">
          <div class="form-group">
            <label class="form-label" for="date">Tanggal</label>
            <input type="date" name="date" id="date" class="form-control" value="<%= (typeof prefill !== 'undefined' && prefill.date) || '' %>" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="timestart">Waktu Mulai</label>
            <select name="timestart" id="timestart" class="form-control" data-prefill="<%= (typeof prefill !== 'undefined' && prefill.timestart) || '' %>" required>
              <option value="">-- Pilih --</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="timeend">Waktu Selesai</label>
            <select name="timeend" id="timeend" class="form-control" data-prefill="<%= (typeof prefill !== 'undefined' && prefill.timeend) || '' %>" required>
              <option value="">-- Pilih --</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="eventname">Nama Acara</label>
          <input type="text" name="eventname" id="eventname" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="eventdescription">Deskripsi Acara</label>
          <textarea name="eventdescription" id="eventdescription" class="form-control"></textarea>
        </div>
        <div class="grid grid-2">
          <div class="form-group">
            <label class="form-label" for="eventpeoplequantity">Jumlah Peserta</label>
            <input type="number" name="eventpeoplequantity" id="eventpeoplequantity" class="form-control" min="1" required>
          </div>
          <% if (currentUser && currentUser.isAdmin) { %>
          <div class="form-group">
            <label class="form-label">Departemen</label>
            <p class="text-muted" style="margin: 0; padding-top: 0.6rem;">Mengikuti Peserta Terkait yang dipilih. Jika tidak ada yang dipilih, memakai departemen Anda.</p>
          </div>
          <% } else { %>
          <div class="form-group">
            <label class="form-label" for="department">Departemen</label>
            <select name="department" id="department" class="form-control" required>
              <option value="">-- Pilih Departemen --</option>
              <% departments.forEach(dept => { %>
                <option value="<%= dept.id %>"><%= dept.namadepartment %></option>
              <% }) %>
            </select>
          </div>
          <% } %>
        </div>

        <div id="kelengkapan-container">
          <% if (equipment && equipment.length > 0) { %>
            <div class="form-group">
              <label class="form-label">Kelengkapan yang Dibutuhkan</label>
              <div class="dropdown" data-multiselect data-placeholder="Pilih kelengkapan..." data-picked-word="kelengkapan dipilih">
                <button type="button" class="form-control dropdown-toggle">
                  <span class="dropdown-label">Pilih kelengkapan...</span>
                </button>
                <div class="dropdown-panel" hidden>
                  <input type="search" class="form-control dropdown-search" placeholder="Cari kelengkapan..." autocomplete="off">
                  <div class="dropdown-list">
                    <% equipment.forEach(item => { %>
                      <label class="dropdown-item">
                        <input type="checkbox" name="kelengkapan[]" value="<%= item.id %>">
                        <span><%= item.NamaKelengkapan %></span>
                      </label>
                    <% }) %>
                  </div>
                  <button type="button" class="btn btn-secondary w-100 mt-2 dropdown-done">Selesai</button>
                </div>
              </div>
            </div>
          <% } else { %>
            <p class="text-muted">Pilih ruangan terlebih dahulu</p>
          <% } %>
        </div>

        <% if (currentUser && currentUser.isAdmin && users && users.length > 0) { %>
          <div class="form-group">
            <label class="form-label">Peserta Terkait (opsional)</label>
            <div class="dropdown" id="participants-dropdown">
              <button type="button" class="form-control dropdown-toggle" id="participants-toggle">
                <span id="participants-label">Pilih peserta...</span>
              </button>
              <div class="dropdown-panel" id="participants-panel" hidden>
                <input type="search" id="participants-search" class="form-control" placeholder="Cari nama atau email..." autocomplete="off">
                <div class="dropdown-list">
                  <% users.filter(u => !currentUser || String(u.id) !== String(currentUser.id)).slice(0, 50).forEach(u => { %>
                    <label class="dropdown-item">
                      <input type="checkbox" name="associated_users[]" value="<%= u.id %>">
                      <span><%= u.namalengkap %> (<%= u.email %>)</span>
                    </label>
                  <% }) %>
                </div>
                <button type="button" class="btn btn-secondary w-100 mt-2" id="participants-done">Selesai</button>
              </div>
            </div>
          </div>
          <script>
          (function () {
            var dd = document.getElementById('participants-dropdown');
            if (!dd) return;
            var toggle = document.getElementById('participants-toggle');
            var panel = document.getElementById('participants-panel');
            var search = document.getElementById('participants-search');
            var label = document.getElementById('participants-label');
            function updateLabel() {
              var n = dd.querySelectorAll('input[name="associated_users[]"]:checked').length;
              label.textContent = n === 0 ? 'Pilih peserta...' : n + ' peserta dipilih';
            }
            toggle.addEventListener('click', function (e) {
              e.stopPropagation();
              panel.hidden = !panel.hidden;
              if (!panel.hidden) search.focus();
            });
            var doneBtn = document.getElementById('participants-done');
            if (doneBtn) doneBtn.addEventListener('click', function () { panel.hidden = true; });
            document.addEventListener('click', function (e) {
              if (!dd.contains(e.target)) panel.hidden = true;
            });
            search.addEventListener('input', function () {
              var q = search.value.trim().toLowerCase();
              dd.querySelectorAll('.dropdown-item').forEach(function (item) {
                item.style.display = item.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
              });
            });
            dd.querySelectorAll('input[name="associated_users[]"]').forEach(function (cb) {
              cb.addEventListener('change', updateLabel);
            });
            updateLabel();
          })();
          </script>
        <% } %>

        <p class="text-muted mb-3">Catatan: booking dari pengguna biasa harus dibuat minimal <%= windowDays %> hari sebelum acara dan menunggu persetujuan admin.</p>
        <button type="submit" class="btn btn-primary w-100">Buat Booking</button>
      </form>
    </div>
  </div>
</div>
