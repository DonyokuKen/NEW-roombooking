<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | RoomBooking</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#EDEFF5">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Fonts load async so a slow font CDN can never block first paint -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"></noscript>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="navbar-container">
      <a href="/" class="navbar-brand">🏢 RoomBooking</a>
      <button type="button" id="menu-toggle" class="menu-toggle" aria-label="Menu">☰</button>
      <ul class="navbar-menu" id="navbar-menu">
        <li><a href="/" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
        <li><a href="/rooms" class="<%= typeof active !== 'undefined' && active === 'rooms' ? 'active' : '' %>">Ruangan</a></li>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <li><a href="/bookings" class="<%= typeof active !== 'undefined' && active === 'bookings' ? 'active' : '' %>">Booking Saya</a></li>
          <li><button type="button" id="notif-bell" class="nav-bell">🔔 Notifikasi<% if (typeof notifCount !== 'undefined' && notifCount > 0) { %><span class="nav-count"><%= notifCount %></span><% } %></button></li>
          <% if (currentUser.isAdmin) { %>
            <li><a href="/admin" class="<%= typeof active !== 'undefined' && active === 'admin' ? 'active' : '' %>">Admin</a></li>
          <% } %>
          <li><a href="/logout">Logout</a></li>
        <% } else { %>
          <li><a href="/login">Login</a></li>
          <li><a href="/register" class="btn btn-primary btn-sm">Daftar</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <!-- Flash Messages -->
  <% if (typeof messages !== 'undefined' && messages) { %>
    <div class="container" style="margin-top: 1.5rem;">
      <% if (messages.success) { %>
        <div class="alert alert-success"><%= messages.success %></div>
      <% } %>
      <% if (messages.error) { %>
        <div class="alert alert-error"><%= messages.error %></div>
      <% } %>
      <% if (messages.warning) { %>
        <div class="alert alert-warning"><%= messages.warning %></div>
      <% } %>
      <% if (messages.info) { %>
        <div class="alert alert-info"><%= messages.info %></div>
      <% } %>
    </div>
  <% } %>

  <!-- Main Content -->
  <main>
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> RoomBooking System. Built with ❤️</p>
    </div>
  </footer>

  <!-- Notification permission popup (bell) — no navigation, no new tab -->
  <div class="notif-modal-backdrop" id="notif-modal">
    <div class="notif-modal">
      <button type="button" class="notif-modal-close" id="notif-modal-close">✕</button>
      <h3 id="notif-modal-title">Izinkan notifikasi?</h3>
      <p id="notif-modal-text">Izinkan notifikasi supaya pengingat booking muncul di perangkat ini.</p>
      <div class="notif-actions">
        <button type="button" class="btn btn-secondary" id="notif-modal-later" style="flex:1">Nanti saja</button>
        <button type="button" class="btn btn-primary" id="notif-modal-allow" style="flex:1">Izinkan</button>
      </div>
      <div class="notif-actions">
        <a class="btn btn-secondary" href="/notifications" style="flex:1">Lihat daftar notifikasi →</a>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
