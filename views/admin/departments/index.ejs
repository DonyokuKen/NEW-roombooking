<%
const deptStatus = s => s === 'A' ? ['Aktif', 'confirmed'] : (s === 'D' ? ['Dihapus', 'cancelled'] : ['Nonaktif', 'pending']);
%>
<div class="container-fluid" style="padding: 2.5rem 1.5rem;">
  <p class="text-muted mb-4"><%= departments.length %> departemen ditemukan</p>

  <% if (duplicateGroups && duplicateGroups.length > 0) { %>
    <div class="card mb-4" style="border: 2px solid #f59e0b;">
      <div class="card-header">
        <h2 class="card-title">⚠️ Duplikat ditemukan — <%= duplicateGroups.length %> grup</h2>
      </div>
      <div class="card-body">
        <p class="text-muted">Nama departemen yang sama persis. Yang dipertahankan adalah id paling kecil; pengguna dan booking yang menyebut duplikat akan dialihkan ke id tersebut, lalu duplikatnya dihapus (soft-delete). Semua pengguna tetap ada.</p>
        <% duplicateGroups.forEach(g => { %>
          <div style="border-top: 1px solid var(--border); padding: 1rem 0;">
            <p>“<%= g.keeper.namadepartment %>”</p>
            <p>✅ Dipertahankan: id <%= g.keeper.id %> “<%= g.keeper.namadepartment %>” (<%= memberCount[g.keeper.id] || 0 %> anggota)</p>
            <% g.losers.forEach(l => { %>
              <p>❌ Dihapus: id <%= l.id %> “<%= l.namadepartment %>” (<%= memberCount[l.id] || 0 %> anggota)</p>
            <% }) %>
            <form method="POST" action="/admin/departments/merge" onsubmit="return confirm('Gabung <%= g.losers.length %> duplikat ke id <%= g.keeper.id %>? Pengguna dan booking akan dialihkan.');">
              <input type="hidden" name="keeperId" value="<%= g.keeper.id %>">
              <% g.losers.forEach(l => { %><input type="hidden" name="loserIds" value="<%= l.id %>"><% }) %>
              <button type="submit" class="btn btn-primary">Gabung duplikat ini</button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (departments && departments.length > 0) { %>
    <div class="card">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Nama Departemen</th>
              <th>Deskripsi</th>
              <th>Anggota</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% departments.forEach(dept => { const st = deptStatus(dept.status); %>
              <tr>
                <td><a href="/admin/departments/<%= dept.id %>"><%= dept.namadepartment %></a></td>
                <td><%= dept.deskripsi || '-' %></td>
                <td><%= memberCount[dept.id] || 0 %></td>
                <td><span class="badge badge-<%= st[1] %>"><%= st[0] %></span></td>
                <td>
                  <form method="POST" action="/admin/departments/<%= dept.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus departemen &quot;<%= dept.namadepartment.replace(/'/g, "\\'") %>&quot;? <%= memberCount[dept.id] || 0 %> anggota dan <%= (typeof bookingCount !== 'undefined' ? bookingCount[dept.id] : 0) || 0 %> booking TIDAK dihapus - referensi departemen mereka dibiarkan apa adanya.');">
                    <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">🏬</div>
      <h2 class="empty-state-title">Tidak ada departemen ditemukan</h2>
      <p class="empty-state-text">Belum ada data departemen pada sistem.</p>
    </div>
  <% } %>
</div>
