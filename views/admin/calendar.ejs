<%
const toMin = t => { const p = String(t || '0:00').split(':'); return (parseInt(p[0]) || 0) * 60 + (parseInt(p[1]) || 0); };
const spanMin = (endHour - startHour) * 60;
const blockPos = b => {
  const s = Math.max(toMin(b.timestart), startHour * 60);
  const e = Math.min(toMin(b.timeend), endHour * 60);
  return {
    left: ((s - startHour * 60) / spanMin * 100).toFixed(2),
    width: (Math.max(e - s, 30) / spanMin * 100).toFixed(2)
  };
};
const statusLabel = s => ({ P: 'Menunggu', A: 'Dikonfirmasi', R: 'Ditolak', C: 'Dibatalkan' }[s] || s);
const hours = [];
for (let h = startHour; h < endHour; h++) hours.push(h);
const nowDate = new Date();
const nowMin = nowDate.getHours() * 60 + nowDate.getMinutes();
const showNow = date === todayStr && nowMin >= startHour * 60 && nowMin <= endHour * 60;
const nowLeft = ((nowMin - startHour * 60) / spanMin * 100).toFixed(2);
const bookingsByRoom = {};
bookings.forEach(b => { (bookingsByRoom[String(b.ruanganid)] = bookingsByRoom[String(b.ruanganid)] || []).push(b); });
const shortRoom = n => String(n || '').replace(/^Tamsir\s*-?\s*/i, '').trim();
%>

<div class="cal-toolbar">
  <form method="GET" action="/admin/calendar" class="cal-filter">
    <span>🏢</span>
    <select name="room" onchange="this.form.submit()">
      <option value="" <%= roomFilter === '' ? 'selected' : '' %>>Semua Ruangan</option>
      <% rooms.forEach(r => { %>
        <option value="<%= r.id %>" <%= String(roomFilter) === String(r.id) ? 'selected' : '' %>><%= r.namaruangan %></option>
      <% }) %>
    </select>
    <input type="hidden" name="date" value="<%= date %>">
  </form>

  <div class="cal-datenav">
    <a href="/admin/calendar?date=<%= prevDate %><%= roomFilter ? '&room=' + roomFilter : '' %>" title="Hari sebelumnya">‹</a>
    <span class="cal-date-label">📅 <%= label %></span>
    <a href="/admin/calendar?date=<%= nextDate %><%= roomFilter ? '&room=' + roomFilter : '' %>" title="Hari berikutnya">›</a>
  </div>

  <% if (date !== todayStr) { %>
    <a class="cal-today" href="/admin/calendar<%= roomFilter ? '?room=' + roomFilter : '' %>">Hari ini</a>
  <% } %>
  <a class="cal-add" href="/bookings/create">＋ Tambah</a>
</div>

<div class="cal-card">
  <div class="cal-scroll">
    <div class="cal-inner">
      <div class="cal-head">
        <div class="cal-room-col">Ruangan</div>
        <div class="cal-hours">
          <% hours.forEach(h => { %><span><%= h %>:00</span><% }) %>
        </div>
      </div>

      <% rooms.forEach(room => {
        const list = bookingsByRoom[String(room.id)] || [];
        if (roomFilter && String(roomFilter) !== String(room.id)) return;
      %>
        <div class="cal-row">
          <div class="cal-room-col cal-room">
            <div class="cal-room-name" title="<%= room.namaruangan %>"><%= shortRoom(room.namaruangan) %></div>
            <div class="cal-room-meta"><%= list.length === 0 ? 'Tidak ada booking' : list.length + ' booking' %></div>
          </div>
          <div class="cal-track" data-room-id="<%= room.id %>" data-room-name="<%= room.namaruangan %>">
            <div class="cal-select"></div>
            <% if (showNow) { %><div class="cal-now" style="left: <%= nowLeft %>%"></div><% } %>
            <% list.forEach(b => { const p = blockPos(b); %>
              <button type="button" class="cal-block st-<%= b.status %>"
                style="left: <%= p.left %>%; width: <%= p.width %>%;"
                data-id="<%= b.id %>"
                data-name="<%= b.eventname %>"
                data-room="<%= b.namaruangan || '' %>"
                data-booker="<%= b.namalengkap || '-' %>"
                data-time="<%= b.timestart %> - <%= b.timeend %>"
                data-status="<%= statusLabel(b.status) %>"
                data-status-code="<%= b.status %>">
                <%= b.eventname %>
                <small><%= b.timestart %>-<%= b.timeend %></small>
              </button>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="cal-legend">
    <span><i class="lg-A"></i>Dikonfirmasi</span>
    <span><i class="lg-P"></i>Menunggu persetujuan</span>
    <span><i class="lg-R"></i>Ditolak / dibatalkan</span>
    <span>💡 Seret di jadwal untuk pilih beberapa jam — klik untuk 1 jam</span>
    <span style="margin-left:auto"><%= bookings.length %> booking pada <%= label %></span>
  </div>
</div>

<!-- Detail modal -->
<div class="cal-modal-backdrop" id="cal-modal">
  <div class="cal-modal">
    <button type="button" class="cal-modal-close" id="cal-modal-close">✕</button>
    <h3 id="m-name">-</h3>
    <div class="m-sub" id="m-room">-</div>
    <div class="m-row"><span>Status</span><span id="m-status">-</span></div>
    <div class="m-row"><span>Waktu</span><span id="m-time">-</span></div>
    <div class="m-row"><span>Tanggal</span><span><%= label %></span></div>
    <div class="m-row"><span>Dibooking oleh</span><span id="m-booker">-</span></div>
    <div class="m-actions" id="m-actions" style="display:none">
      <form method="POST" id="m-approve" style="flex:1;display:flex">
        <button type="submit" class="btn btn-approve" style="flex:1">Setujui</button>
      </form>
      <form method="POST" id="m-reject" style="flex:1;display:flex">
        <button type="submit" class="btn btn-reject" style="flex:1">Tolak</button>
      </form>
    </div>
    <div class="m-actions">
      <a class="btn btn-secondary" id="m-detail" href="#" style="flex:1">Lihat Detail</a>
    </div>
  </div>
</div>

<!-- New-booking modal (click an empty slot) -->
<div class="cal-modal-backdrop" id="cal-new-modal">
  <div class="cal-modal">
    <button type="button" class="cal-modal-close" id="cal-new-close">✕</button>
    <h3>Booking Baru</h3>
    <div class="m-sub" id="n-room">-</div>
    <div class="m-row"><span>Tanggal</span><span><%= label %></span></div>
    <div class="m-row"><span>Waktu</span><span><input type="time" id="n-start" class="cal-time-input" step="1800"> – <input type="time" id="n-end" class="cal-time-input" step="1800"></span></div>
    <div class="m-row"><span>Durasi</span><span id="n-chips"><button type="button" class="cal-chip" data-hours="1">1 jam</button><button type="button" class="cal-chip" data-hours="2">2 jam</button><button type="button" class="cal-chip" data-hours="3">3 jam</button><button type="button" class="cal-chip" data-hours="4">4 jam</button></span></div>
    <div class="m-actions">
      <a class="btn btn-primary" id="n-go" href="#" style="flex:1">Buat Booking →</a>
    </div>
  </div>
</div>

<script>
(function () {
  var backdrop = document.getElementById('cal-modal');
  var closeBtn = document.getElementById('cal-modal-close');
  function close() { backdrop.classList.remove('open'); }
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', function (e) { if (e.target === backdrop) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  document.querySelectorAll('.cal-block').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var d = btn.dataset;
      document.getElementById('m-name').textContent = d.name;
      document.getElementById('m-room').textContent = d.room;
      document.getElementById('m-status').textContent = d.status;
      document.getElementById('m-time').textContent = d.time;
      document.getElementById('m-booker').textContent = d.booker;
      document.getElementById('m-detail').href = '/admin/bookings/' + d.id;
      var acts = document.getElementById('m-actions');
      if (d.statusCode === 'P') {
        acts.style.display = 'flex';
        document.getElementById('m-approve').action = '/admin/bookings/' + d.id + '/approve';
        document.getElementById('m-reject').action = '/admin/bookings/' + d.id + '/reject';
      } else {
        acts.style.display = 'none';
      }
      backdrop.classList.add('open');
    });
  });
})();

// Drag across one room's track to select several hours (the selection
// stays in the room where the drag started — it can't cross rooms).
// A plain click/tap still books 1 hour. The range can also be picked in
// the modal: one-tap duration chips (1/2/3/4 jam) or the time pickers.
(function () {
  var backdrop = document.getElementById('cal-new-modal');
  var closeBtn = document.getElementById('cal-new-close');
  var startHour = <%= startHour %>, endHour = <%= endHour %>;
  var dayStart = startHour * 60, dayEnd = endHour * 60;
  var dateStr = '<%= date %>';
  var sel = null; // { roomId, roomName, start, end }
  var drag = null; // { track, anchor, startX, moved }
  var openedAt = 0; // when the modal last opened (guards the synthetic click after a touch tap)

  function fmt(mins) {
    var h = Math.floor(mins / 60), m = mins % 60;
    return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
  }
  function minsAt(track, clientX) {
    var rect = track.getBoundingClientRect();
    var frac = (clientX - rect.left) / rect.width;
    frac = Math.max(0, Math.min(1, frac));
    return Math.round((dayStart + frac * (dayEnd - dayStart)) / 30) * 30;
  }
  function showSel(track, a, b) {
    var el = track.querySelector('.cal-select');
    var lo = Math.min(a, b), hi = Math.max(a, b);
    if (hi - lo < 30) hi = lo + 30;
    el.style.left = ((lo - dayStart) / (dayEnd - dayStart) * 100) + '%';
    el.style.width = ((hi - lo) / (dayEnd - dayStart) * 100) + '%';
    el.classList.add('on');
  }
  function hideSel(track) {
    track.querySelector('.cal-select').classList.remove('on');
  }
  function parseTime(v) {
    var m = /^([01]\d|2[0-3]):([0-5]\d)$/.exec(v || '');
    return m ? (+m[1]) * 60 + (+m[2]) : null;
  }
  function updateModal() {
    document.getElementById('n-room').textContent = sel.roomName;
    document.getElementById('n-start').value = fmt(sel.start);
    document.getElementById('n-end').value = fmt(sel.end);
    document.getElementById('n-go').href = '/bookings/create?room_id=' + sel.roomId +
      '&date=' + dateStr + '&timestart=' + fmt(sel.start) + '&timeend=' + fmt(sel.end);
    var dur = sel.end - sel.start;
    document.querySelectorAll('#n-chips .cal-chip').forEach(function (chip) {
      chip.classList.toggle('on', dur === (+chip.dataset.hours) * 60);
    });
  }
  function openModal() {
    updateModal();
    backdrop.classList.add('open');
    openedAt = Date.now();
  }
  function close() { backdrop.classList.remove('open'); }
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', function (e) {
    // A touch tap opens the modal on pointerup, then the browser fires a
    // synthetic click at the same spot — it would land on the backdrop and
    // close the modal instantly. Ignore backdrop clicks right after opening.
    if (e.target === backdrop && Date.now() - openedAt > 400) close();
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  // One tap sets the whole duration; the time pickers allow any start/end.
  document.querySelectorAll('#n-chips .cal-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      if (!sel) return;
      sel.end = Math.min(sel.start + (+chip.dataset.hours) * 60, dayEnd);
      updateModal();
    });
  });
  function readTimes() {
    if (!sel) return;
    var s = parseTime(document.getElementById('n-start').value);
    var e = parseTime(document.getElementById('n-end').value);
    if (s !== null) sel.start = Math.max(dayStart, Math.min(s, dayEnd - 30));
    if (e !== null) sel.end = Math.max(dayStart + 30, Math.min(e, dayEnd));
    if (sel.end - sel.start < 30) sel.end = Math.min(sel.start + 30, dayEnd);
    if (sel.end - sel.start < 30) sel.start = sel.end - 30;
    updateModal();
  }
  document.getElementById('n-start').addEventListener('change', readTimes);
  document.getElementById('n-end').addEventListener('change', readTimes);

  document.querySelectorAll('.cal-track').forEach(function (track) {
    track.addEventListener('pointerdown', function (e) {
      if (e.target.closest('.cal-block')) return;
      drag = { track: track, anchor: minsAt(track, e.clientX), startX: e.clientX, moved: false };
      if (e.pointerType === 'mouse' || e.pointerType === 'pen') {
        try { track.setPointerCapture(e.pointerId); } catch (_) {}
      }
    });
    track.addEventListener('pointermove', function (e) {
      if (!drag || drag.track !== track) return;
      if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
      if (Math.abs(e.clientX - drag.startX) < 6) return;
      drag.moved = true;
      showSel(track, drag.anchor, minsAt(track, e.clientX));
    });
    function finish(e, cancelled) {
      if (!drag || drag.track !== track) return;
      var d = drag; drag = null;
      hideSel(track);
      if (cancelled) return;
      var start, end;
      if (d.moved) {
        var cur = minsAt(track, e.clientX);
        start = Math.min(d.anchor, cur);
        end = Math.max(d.anchor, cur);
        if (end - start < 30) end = start + 30;
        if (end > dayEnd) { end = dayEnd; start = Math.max(dayStart, end - 30); }
      } else {
        start = d.anchor;
        end = Math.min(start + 60, dayEnd);
        if (end - start < 30) start = end - 30;
      }
      sel = { roomId: track.dataset.roomId, roomName: track.dataset.roomName, start: start, end: end };
      openModal();
    }
    track.addEventListener('pointerup', function (e) { finish(e, false); });
    track.addEventListener('pointercancel', function (e) { finish(e, true); });
  });
})();
</script>
