<%
const roomStatus = s => s === 'A' ? ['Tersedia', 'confirmed'] : (s === 'D' ? ['Dihapus', 'cancelled'] : ['Tidak Tersedia', 'pending']);
const qs = p => `/admin/rooms?page=${p}&search=${encodeURIComponent(search || '')}`;
%>
<div class="container-fluid" style="padding: 2.5rem 1.5rem;">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
      <h1 class="mb-1">Kelola Ruangan</h1>
      <p class="text-muted"><%= total %> ruangan ditemukan</p>
    </div>
    <a href="/admin/rooms/create" class="btn btn-primary">+ Tambah Ruangan</a>
  </div>

  <form method="GET" action="/admin/rooms" class="filters search-form mb-4">
    <div class="filters-row">
      <div class="form-group" style="flex: 1;">
        <input type="text" name="search" class="form-control" placeholder="Cari ruangan..." value="<%= search || '' %>">
      </div>
      <button type="submit" class="btn btn-primary">Cari</button>
    </div>
  </form>

  <% if (rooms && rooms.length > 0) { %>
    <div class="card">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Nama Ruangan</th>
              <th>Deskripsi</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% rooms.forEach(room => { const st = roomStatus(room.status); %>
              <tr>
                <td><a href="/rooms/<%= room.id %>"><%= room.namaruangan %></a></td>
                <td><%= room.description || '-' %></td>
                <td><span class="badge badge-<%= st[1] %>"><%= st[0] %></span></td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/admin/rooms/<%= room.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                    <% if (room.status !== 'D') { %>
                      <form method="POST" action="/admin/rooms/<%= room.id %>/delete" onsubmit="return confirm('Hapus ruangan ini?')">
                        <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %><a href="<%= qs(page - 1) %>">&laquo; Sebelumnya</a><% } %>
        <% for (let p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
          <% if (p === page) { %><span class="active"><%= p %></span><% } else { %><a href="<%= qs(p) %>"><%= p %></a><% } %>
        <% } %>
        <% if (page < totalPages) { %><a href="<%= qs(page + 1) %>">Berikutnya &raquo;</a><% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">🏢</div>
      <h2 class="empty-state-title">Tidak ada ruangan ditemukan</h2>
      <p class="empty-state-text">Coba ubah kata kunci pencarian Anda.</p>
    </div>
  <% } %>
</div>
