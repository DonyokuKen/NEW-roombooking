<div class="container" style="max-width: 640px; padding: 2.5rem 1.5rem;">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Edit Ruangan</h2>
    </div>
    <div class="card-body">
      <form method="POST" action="/admin/rooms/<%= room.id %>">
        <div class="form-group">
          <label class="form-label" for="namaruangan">Nama Ruangan</label>
          <input type="text" name="namaruangan" id="namaruangan" class="form-control" value="<%= room.namaruangan %>" required autofocus>
        </div>
        <div class="form-group">
          <label class="form-label" for="description">Deskripsi</label>
          <textarea name="description" id="description" class="form-control"><%= room.description || '' %></textarea>
        </div>
        <div class="form-group">
          <label class="form-label" for="status">Status</label>
          <select name="status" id="status" class="form-control">
            <option value="A" <%= room.status === 'A' ? 'selected' : '' %>>Tersedia</option>
            <option value="N" <%= room.status === 'N' ? 'selected' : '' %>>Tidak Tersedia</option>
            <option value="D" <%= room.status === 'D' ? 'selected' : '' %>>Dihapus</option>
          </select>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
          <a href="/admin/rooms" class="btn btn-secondary">Batal</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Equipment for this room -->
  <div class="card" style="margin-top: 1.5rem;">
    <div class="card-header">
      <h2 class="card-title">Kelengkapan Ruangan</h2>
    </div>
    <div class="card-body">
      <% if (equipment && equipment.length > 0) { %>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Nama Kelengkapan</th>
                <th>Status</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% equipment.forEach(item => { %>
                <tr>
                  <td><%= item.NamaKelengkapan %></td>
                  <td><span class="badge badge-<%= item.status === 'A' ? 'confirmed' : 'pending' %>"><%= item.status === 'A' ? 'Tersedia' : 'Tidak Tersedia' %></span></td>
                  <td>
                    <form method="POST" action="/admin/rooms/<%= room.id %>/equipment/<%= item.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus <%= item.NamaKelengkapan.replace(/'/g, "\\'") %> dari ruangan ini?');">
                      <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted">Belum ada kelengkapan di ruangan ini.</p>
      <% } %>
      <form method="POST" action="/admin/rooms/<%= room.id %>/equipment" style="margin-top: 1rem;">
        <div class="d-flex gap-2">
          <input type="text" name="NamaKelengkapan" class="form-control" placeholder="Nama kelengkapan baru, contoh: Proyektor" required>
          <button type="submit" class="btn btn-primary">+ Tambah</button>
        </div>
      </form>
      <% if (unassigned && unassigned.length > 0) { %>
        <form method="POST" action="/admin/rooms/<%= room.id %>/equipment/attach" style="margin-top: 1rem;">
          <div class="d-flex gap-2">
            <select name="eqId" class="form-control" required>
              <option value="">— Pasang kelengkapan yang belum ada ruangan —</option>
              <% unassigned.forEach(item => { %>
                <option value="<%= item.id %>"><%= item.NamaKelengkapan %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-secondary">Pasang</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
</div>
