<div class="adm-stats">
  <div class="adm-stat">
    <div class="adm-stat-ico blue">🗓️</div>
    <div><div class="adm-stat-num"><%= stats.total %></div><div class="adm-stat-label">Total Booking</div></div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat-ico orange">⏳</div>
    <div><div class="adm-stat-num"><%= stats.pending %></div><div class="adm-stat-label">Menunggu Approval</div></div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat-ico green">✅</div>
    <div><div class="adm-stat-num"><%= stats.accepted %></div><div class="adm-stat-label">Dikonfirmasi</div></div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat-ico purple">📍</div>
    <div><div class="adm-stat-num"><%= stats.today %></div><div class="adm-stat-label">Booking Hari Ini</div></div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat-ico pink">🚪</div>
    <div><div class="adm-stat-num"><%= stats.rooms %></div><div class="adm-stat-label">Ruangan Aktif</div></div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat-ico grey">👥</div>
    <div><div class="adm-stat-num"><%= stats.users %></div><div class="adm-stat-label">Pengguna Aktif</div></div>
  </div>
</div>

<div class="adm-quick">
  <a href="/admin/calendar" class="btn btn-primary">📅 Lihat Kalender</a>
  <a href="/bookings/create" class="btn btn-secondary">＋ Buat Booking</a>
  <a href="/admin/bookings" class="btn btn-secondary">Kelola Booking</a>
  <a href="/admin/rooms" class="btn btn-secondary">Kelola Ruangan</a>
  <a href="/admin/users" class="btn btn-secondary">Kelola Pengguna</a>
</div>

<h2 class="adm-section-title">Booking Menunggu Persetujuan</h2>
<div class="adm-panel">
  <% if (pendingBookings && pendingBookings.length > 0) { %>
    <% pendingBookings.forEach(booking => { %>
      <div class="adm-row-item">
        <div class="adm-date-badge">
          <div class="d"><%= new Date(booking.date).getDate() %></div>
          <div class="m"><%= new Date(booking.date).toLocaleDateString('id-ID', { month: 'short' }) %></div>
        </div>
        <div class="adm-row-main">
          <a href="/admin/bookings/<%= booking.id %>"><%= booking.eventname %></a>
          <div class="adm-row-meta">
            <span>🏢 <%= booking.namaruangan || '-' %></span>
            <span>⏰ <%= booking.timestart %> - <%= booking.timeend %></span>
            <span>👤 <%= booking.namalengkap || '-' %></span>
          </div>
        </div>
        <span class="badge badge-pending">Tertunda</span>
      </div>
    <% }) %>
  <% } else { %>
    <p class="adm-empty">Tidak ada booking yang menunggu persetujuan.</p>
  <% } %>
</div>

<h2 class="adm-section-title">Acara Hari Ini</h2>
<div class="adm-panel">
  <% if (todayEvents && todayEvents.length > 0) { %>
    <% todayEvents.forEach(event => { %>
      <div class="adm-row-item">
        <div class="adm-row-main">
          <a href="/admin/bookings/<%= event.id %>"><%= event.eventname %></a>
          <div class="adm-row-meta">
            <span>🏢 <%= event.namaruangan || '-' %></span>
            <span>⏰ <%= event.timestart %> - <%= event.timeend %></span>
            <span>👤 <%= event.namalengkap || '-' %></span>
          </div>
        </div>
        <span class="badge badge-confirmed">Dikonfirmasi</span>
      </div>
    <% }) %>
  <% } else { %>
    <p class="adm-empty">Tidak ada acara terkonfirmasi hari ini.</p>
  <% } %>
</div>
