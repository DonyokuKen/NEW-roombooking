<%
const roleLabel = r => ({ U: 'Pengguna', M: 'Manager', SU: 'Super Admin' }[r] || r);
const qs = p => `/admin/users?page=${p}&search=${encodeURIComponent(search || '')}&dept=${encodeURIComponent(dept || '')}`;
const isSU = typeof currentUser !== 'undefined' && currentUser && currentUser.isSuperAdmin;
const isAdmin = typeof currentUser !== 'undefined' && currentUser && currentUser.isAdmin;
// Last login is a DATETIME read in server-local (Asia/Jakarta) time; show
// it as-is in WIB. NULL (never logged in since the column was added) -> '-'.
const fmtLogin = v => {
  if (!v) return '-';
  const d = new Date(v);
  if (isNaN(d.getTime())) return '-';
  return d.toLocaleString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Jakarta' });
};
%>
<div class="container-fluid" style="padding: 2.5rem 1.5rem;">
  <p class="text-muted mb-4"><%= total %> pengguna ditemukan</p>

  <form method="GET" action="/admin/users" class="filters search-form mb-4">
    <div class="filters-row">
      <div class="form-group" style="flex: 1;">
        <input type="text" name="search" class="form-control" placeholder="Cari nama atau email..." value="<%= search || '' %>">
      </div>
      <div class="form-group">
        <select name="dept" class="form-control" onchange="this.form.submit()">
          <option value="">Semua Departemen</option>
          <% (departments || []).forEach(d => { %>
            <option value="<%= d.id %>" <%= String(dept) === String(d.id) ? 'selected' : '' %>><%= d.namadepartment %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Cari</button>
    </div>
  </form>

  <% if (users && users.length > 0) { %>
    <div class="card">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Nama Lengkap</th>
              <th>Email</th>
              <th>No. Telepon</th>
              <th>Jenis Kelamin</th>
              <th>Departemen</th>
              <th>Peran</th>
              <th>Status</th>
              <th>Login Terakhir</th>
              <% if (isAdmin) { %><th>Aksi</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td><a href="/admin/users/<%= user.id %>"><%= user.namalengkap %></a></td>
                <td><%= user.email %></td>
                <td><%= user.notelp || '-' %></td>
                <td><%= user.gender === 'P' ? 'Perempuan' : 'Laki-laki' %></td>
                <td><%= user.dept_name || user.dept || '-' %></td>
                <td><%= roleLabel(user.roles) %></td>
                <td><span class="badge badge-<%= user.userstatus === 'A' ? 'confirmed' : 'cancelled' %>"><%= user.userstatus === 'A' ? 'Aktif' : 'Nonaktif' %></span></td>
                <td><%= fmtLogin(user.last_login_at) %></td>
                <% if (isAdmin) { %><td><a href="/admin/users/<%= user.id %>/edit" class="btn btn-sm btn-secondary">Edit</a><% if (isSU && String(user.id) !== String(currentUser.id)) { %> <form method="POST" action="/admin/users/<%= user.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus pengguna &quot;<%= user.namalengkap.replace(/'/g, "\\'") %>&quot;? <%= (typeof bookingCounts !== 'undefined' ? bookingCounts[user.id] : 0) || 0 %> booking sebagai pemesan TIDAK dihapus.');"><button type="submit" class="btn btn-sm btn-danger">Hapus</button></form><% } %></td><% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %><a href="<%= qs(page - 1) %>">&laquo; Sebelumnya</a><% } %>
        <% for (let p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
          <% if (p === page) { %><span class="active"><%= p %></span><% } else { %><a href="<%= qs(p) %>"><%= p %></a><% } %>
        <% } %>
        <% if (page < totalPages) { %><a href="<%= qs(page + 1) %>">Berikutnya &raquo;</a><% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">👥</div>
      <h2 class="empty-state-title">Tidak ada pengguna ditemukan</h2>
      <p class="empty-state-text">Coba ubah kata kunci pencarian Anda.</p>
    </div>
  <% } %>
</div>
