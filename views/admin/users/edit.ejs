<%
const deptIds = new Set((departments || []).map(d => String(d.id)));
const currentDept = String(editUser.dept || '');
const deptIsListed = !currentDept || deptIds.has(currentDept);
%>
<div class="container" style="max-width: 640px; padding: 2.5rem 1.5rem;">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Edit Pengguna</h2>
    </div>
    <div class="card-body">
      <form method="POST" action="/admin/users/<%= editUser.id %>/edit">
        <div class="form-group">
          <label class="form-label" for="namalengkap">Nama Lengkap</label>
          <input type="text" name="namalengkap" id="namalengkap" class="form-control" value="<%= editUser.namalengkap %>" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input type="email" name="email" id="email" class="form-control" value="<%= editUser.email %>" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="notelp">No. Telepon</label>
          <input type="text" name="notelp" id="notelp" class="form-control" value="<%= editUser.notelp || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="gender">Jenis Kelamin</label>
          <select name="gender" id="gender" class="form-control">
            <option value="L" <%= editUser.gender !== 'P' ? 'selected' : '' %>>Laki-laki</option>
            <option value="P" <%= editUser.gender === 'P' ? 'selected' : '' %>>Perempuan</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="dept">Departemen</label>
          <select name="dept" id="dept" class="form-control">
            <% if (!deptIsListed) { %>
              <option value="<%= editUser.dept %>" selected><%= currentDeptLabel %> (saat ini)</option>
            <% } %>
            <% (departments || []).forEach(d => { %>
              <option value="<%= d.id %>" <%= currentDept === String(d.id) ? 'selected' : '' %>><%= d.namadepartment %></option>
            <% }) %>
          </select>
        </div>
        <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
        <div class="form-group">
          <label class="form-label" for="roles">Peran</label>
          <select name="roles" id="roles" class="form-control">
            <option value="U" <%= editUser.roles === 'U' ? 'selected' : '' %>>Pengguna</option>
            <option value="M" <%= editUser.roles === 'M' ? 'selected' : '' %>>Manager</option>
            <option value="SU" <%= editUser.roles === 'SU' ? 'selected' : '' %>>Super Admin</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="userstatus">Status</label>
          <select name="userstatus" id="userstatus" class="form-control">
            <option value="A" <%= editUser.userstatus === 'A' ? 'selected' : '' %>>Aktif</option>
            <option value="N" <%= editUser.userstatus !== 'A' ? 'selected' : '' %>>Nonaktif</option>
          </select>
        </div>
        <% } else { %>
        <div class="form-group">
          <label class="form-label">Peran</label>
          <p class="form-control" style="background: var(--bg, #f3f4f6);"><%= editUser.roles === 'SU' ? 'Super Admin' : (editUser.roles === 'M' ? 'Manager' : 'Pengguna') %> — hanya Super Admin yang bisa mengubah peran</p>
        </div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <p class="form-control" style="background: var(--bg, #f3f4f6);"><%= editUser.userstatus === 'A' ? 'Aktif' : 'Nonaktif' %> — hanya Super Admin yang bisa mengubah status</p>
        </div>
        <% } %>
        <div class="form-group">
          <label class="form-label" for="password">Reset Password (opsional)</label>
          <input type="password" name="password" id="password" class="form-control" placeholder="Kosongkan jika tidak diubah" autocomplete="new-password">
          <p class="text-muted" style="margin-top: 0.5rem;">Isi untuk mengganti password pengguna ini (minimal 6 karakter). Kosong berarti password lama tetap berlaku.</p>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
          <a href="/admin/users" class="btn btn-secondary">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>
