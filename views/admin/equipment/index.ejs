<%
const eqStatus = s => s === 'A' ? ['Tersedia', 'confirmed'] : (s === 'D' ? ['Dihapus', 'cancelled'] : ['Tidak Tersedia', 'pending']);
const roomName = id => { const r = (rooms || []).find(r => String(r.id) === String(id)); return r ? r.namaruangan : null; };
const roomLabel = g => g.roomId === null || g.roomId === undefined ? 'Tanpa Ruangan' : (roomName(g.roomId) || ('Ruangan #' + g.roomId));
const groups = {};
(equipment || []).forEach(item => {
  const key = item.namaruangan || roomName(item.idruangan) || 'Tanpa Ruangan';
  if (!groups[key]) groups[key] = [];
  groups[key].push(item);
});
const groupNames = Object.keys(groups).sort();
%>
<div class="container-fluid" style="padding: 2.5rem 1.5rem;">
  <p class="text-muted mb-4"><%= equipment.length %> kelengkapan ditemukan</p>

  <div class="card mb-4">
    <div class="card-body">
      <form method="POST" action="/admin/equipment">
        <div class="d-flex gap-2">
          <select name="idruangan" class="form-control" style="max-width: 280px;">
            <option value="">Tanpa Ruangan</option>
            <% (rooms || []).forEach(r => { %>
              <option value="<%= r.id %>"><%= r.namaruangan %></option>
            <% }) %>
          </select>
          <input type="text" name="NamaKelengkapan" class="form-control" placeholder="Nama kelengkapan baru, contoh: Proyektor" required>
          <button type="submit" class="btn btn-primary">+ Tambah</button>
        </div>
      </form>
    </div>
  </div>

  <% if (duplicateGroups && duplicateGroups.length > 0) { %>
    <div class="card mb-4" style="border: 2px solid #f59e0b;">
      <div class="card-header">
        <h2 class="card-title">⚠️ Duplikat ditemukan — <%= duplicateGroups.length %> grup</h2>
      </div>
      <div class="card-body">
        <p class="text-muted">Nama yang sama di ruangan yang sama. Yang dipertahankan adalah id paling kecil; semua booking yang menyebut duplikat akan dialihkan ke id tersebut, lalu duplikatnya dihapus (soft-delete). Nama yang sama di ruangan berbeda <strong>bukan</strong> duplikat dan tidak digabung.</p>
        <% duplicateGroups.forEach(g => { %>
          <div style="border-top: 1px solid var(--border); padding: 1rem 0;">
            <p><strong><%= roomLabel(g) %></strong> — “<%= g.keeper.NamaKelengkapan %>”</p>
            <p>✅ Dipertahankan: id <%= g.keeper.id %> “<%= g.keeper.NamaKelengkapan %>” (<%= eqStatus(g.keeper.status)[0] %>, dipakai <%= refCounts[g.keeper.id] || 0 %> booking)</p>
            <% g.losers.forEach(l => { %>
              <p>❌ Dihapus: id <%= l.id %> “<%= l.NamaKelengkapan %>” (<%= eqStatus(l.status)[0] %>, dipakai <%= refCounts[l.id] || 0 %> booking)</p>
            <% }) %>
            <form method="POST" action="/admin/equipment/merge" onsubmit="return confirm('Gabung <%= g.losers.length %> duplikat ke id <%= g.keeper.id %>? <%= g.losers.reduce((n, l) => n + (refCounts[l.id] || 0), 0) %> referensi booking akan dialihkan.');">
              <input type="hidden" name="keeperId" value="<%= g.keeper.id %>">
              <% g.losers.forEach(l => { %><input type="hidden" name="loserIds" value="<%= l.id %>"><% }) %>
              <button type="submit" class="btn btn-primary">Gabung duplikat ini</button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (equipment && equipment.length > 0) { %>
    <% groupNames.forEach(name => { %>
      <h2 class="mt-4 mb-3">🏢 <%= name %></h2>
      <div class="card mb-4">
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Nama Kelengkapan</th>
                <th>Status</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% groups[name].forEach(item => { const st = eqStatus(item.status); %>
                <tr>
                  <td><%= item.NamaKelengkapan %></td>
                  <td><span class="badge badge-<%= st[1] %>"><%= st[0] %></span></td>
                  <td>
                    <a href="/admin/equipment/<%= item.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                    <form method="POST" action="/admin/equipment/<%= item.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus &quot;<%= item.NamaKelengkapan.replace(/'/g, "\\'") %>&quot;? Dipakai <%= (typeof refCounts !== 'undefined' ? refCounts[item.id] : 0) || 0 %> booking - referensi booking dibiarkan apa adanya.');">
                      <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">🎒</div>
      <h2 class="empty-state-title">Tidak ada kelengkapan ditemukan</h2>
      <p class="empty-state-text">Belum ada data kelengkapan pada sistem.</p>
    </div>
  <% } %>
</div>
