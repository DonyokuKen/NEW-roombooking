<div class="container" style="padding: 2.5rem 1.5rem;">
  <h1 class="mb-2">Daftar Ruangan</h1>
  <p class="text-muted mb-4"><%= total %> ruangan ditemukan</p>

  <form method="GET" action="/rooms" class="filters search-form mb-4">
    <div class="filters-row">
      <div class="form-group" style="flex: 1;">
        <input type="text" name="search" class="form-control" placeholder="Cari ruangan..." value="<%= search || '' %>">
      </div>
      <div class="form-group">
        <select name="status" class="form-control">
          <option value="A" <%= status === 'A' ? 'selected' : '' %>>Tersedia</option>
          <option value="N" <%= status === 'N' ? 'selected' : '' %>>Tidak Tersedia</option>
          <option value="" <%= status === '' ? 'selected' : '' %>>Semua Status</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Cari</button>
    </div>
  </form>

  <% if (rooms && rooms.length > 0) { %>
    <div class="grid grid-3">
      <% rooms.forEach(room => { %>
        <div class="room-card">
          <div class="room-card-image">🏢</div>
          <div class="room-card-body">
            <h3 class="room-card-title"><%= room.namaruangan %></h3>
            <p class="room-card-desc"><%= room.description || 'Ruangan tersedia untuk booking' %></p>
            <div class="room-card-footer">
              <span class="badge badge-<%= room.status === 'A' ? 'confirmed' : 'pending' %>">
                <%= room.status === 'A' ? 'Tersedia' : 'Tidak Tersedia' %>
              </span>
              <a href="/rooms/<%= room.id %>" class="btn btn-sm btn-primary">Lihat Detail</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %>
          <a href="/rooms?page=<%= page - 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= status %>">&laquo; Sebelumnya</a>
        <% } %>
        <% for (let p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
          <% if (p === page) { %>
            <span class="active"><%= p %></span>
          <% } else { %>
            <a href="/rooms?page=<%= p %>&search=<%= encodeURIComponent(search || '') %>&status=<%= status %>"><%= p %></a>
          <% } %>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="/rooms?page=<%= page + 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= status %>">Berikutnya &raquo;</a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">🏢</div>
      <h2 class="empty-state-title">Tidak ada ruangan ditemukan</h2>
      <p class="empty-state-text">Coba ubah kata kunci atau filter pencarian Anda.</p>
    </div>
  <% } %>
</div>
